// PhantomFence resources: application icon + version info.
// Compile: x86_64-w64-mingw32-windres PhantomFence.rc phantomfence_res.o
#include <winver.h>

1 ICON "phantomfence.ico"

1 VERSIONINFO
FILEVERSION     1,2,0,0
PRODUCTVERSION  1,2,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Solemn Scribe"
      VALUE "FileDescription",  "Phantom Fence - keeps windows and the mouse off phantom displays"
      VALUE "FileVersion",      "1.2.0.0"
      VALUE "InternalName",     "PhantomFence"
      VALUE "LegalCopyright",   "(c) 2026 Solemn Scribe"
      VALUE "OriginalFilename", "PhantomFence.exe"
      VALUE "ProductName",      "Phantom Fence"
      VALUE "ProductVersion",   "1.2.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
